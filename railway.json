{
  "$schema": "https://railway.app/schema.json",
  "name": "geothermal-hub",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "pkgs": ["nodejs_20"],
      "installCommand": "npm install && npm run build"
    }
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
